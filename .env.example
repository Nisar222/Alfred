# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
POSTGRES_DB=jamal_dialler
POSTGRES_USER=jamal
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# The dashboard/API stays private to the VPS by default. A TLS reverse proxy
# (Caddy or Nginx) should be the only public entry point.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
CALL_PROVIDER=simulator
MAX_CONCURRENT_CALLS=8
CORS_ORIGINS=http://localhost:8000

# 3CX V20 Call Control (never commit a real key).
THREECX_BASE_URL=https://your-pbx.3cx.cloud
THREECX_APP_ID=your-service-principal-id
THREECX_API_KEY=CHANGE_ME_STORE_ONLY_ON_VPS
THREECX_CONTROL_EXTENSION=101

# Prerecorded-message test file and timing. Test and live campaign switches are
# controlled in Alfred Settings, never here.
THREECX_TEST_DESTINATION=+15551234567
THREECX_TEST_FIRST_DESTINATION=802
THREECX_TEST_FORWARD_DESTINATION=803
THREECX_TEST_FORWARD_WAIT_SECONDS=25
THREECX_TEST_HOLD_WAIT_SECONDS=45
THREECX_TEST_CALL_TIMEOUT_SECONDS=45
# Optional second MP3 for guided-transfer POC; defaults to the opening message file.
# TRANSFER_MESSAGE_PATH=/app/media/transfer-message.mp3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPT_SYNC_ENABLED=true
